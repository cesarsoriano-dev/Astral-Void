$HYDE_THEME = Astral-Void
$GTK_THEME = Decay-Green
$ICON_THEME = Tela-circle-dracula
$CURSOR_THEME = Bibata-Modern-Ice
$CURSOR_SIZE = 24
$FONT = JetBrainsMono Nerd Font
$FONT_SIZE = 11
$DOCUMENT_FONT = JetBrainsMono Nerd Font
$DOCUMENT_FONT_SIZE = 11
$MONOSPACE_FONT = JetBrainsMono Nerd Font
$MONOSPACE_FONT_SIZE = 11

exec = gsettings set org.gnome.desktop.interface icon-theme '$ICON_THEME'
exec = gsettings set org.gnome.desktop.interface gtk-theme '$GTK_THEME'
exec = gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec = gsettings set org.gnome.desktop.interface cursor-theme '$CURSOR_THEME'
exec = gsettings set org.gnome.desktop.interface cursor-size $CURSOR_SIZE
exec = gsettings set org.gnome.desktop.interface font-name '$FONT $FONT_SIZE'
exec = gsettings set org.gnome.desktop.interface document-font-name '$DOCUMENT_FONT $DOCUMENT_FONT_SIZE'
exec = gsettings set org.gnome.desktop.interface monospace-font-name '$MONOSPACE_FONT $MONOSPACE_FONT_SIZE'

general {
    gaps_in = 6
    gaps_out = 12
    border_size = 2
    col.active_border = rgba(bd93f9ff) rgba(8be9fdff) rgba(ff79c6ff) rgba(ffb86cff) 45deg
    col.inactive_border = rgba(0a0816aa) rgba(bd93f940) 45deg
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(bd93f9ff) rgba(8be9fdff) rgba(ff79c6ff) rgba(ffb86cff) 45deg
    col.border_inactive = rgba(0a0816cc) rgba(bd93f940) 45deg
    col.border_locked_active = rgba(ff79c6ff) rgba(ffb86cff) 45deg
    col.border_locked_inactive = rgba(0a0816cc) rgba(ff79c640) 45deg

    groupbar {
        font_family = JetBrainsMono Nerd Font
        font_size = 10
        col.active = rgba(bd93f9cc)
        col.inactive = rgba(0a0816cc)
        col.locked_active = rgba(ff79c6cc)
        col.locked_inactive = rgba(0a0816cc)
    }
}

decoration {
    rounding = 16
    active_opacity = 0.96
    inactive_opacity = 0.88
    fullscreen_opacity = 1.0

    blur {
        enabled = true
        size = 8
        passes = 3
        new_optimizations = true
        ignore_opacity = true
        xray = false
        noise = 0.015
        contrast = 1.1
        brightness = 0.9
        vibrancy = 0.25
        vibrancy_darkness = 0.5
        popups = true
    }

    shadow {
        enabled = true
        range = 24
        render_power = 3
        color = rgba(05040add)
        color_inactive = rgba(05040a88)
        offset = 0 4
    }
}

animations {
    enabled = true
    bezier = cosmicSpring, 0.05, 0.95, 0.1, 1.08
    bezier = deepDecel, 0.1, 1, 0.1, 1
    bezier = borderSpin, 0.45, 0, 0.55, 1

    animation = windows, 1, 4.5, cosmicSpring, popin 80%
    animation = windowsOut, 1, 3.5, deepDecel, popin 85%
    animation = windowsMove, 1, 4, deepDecel
    animation = border, 1, 8, default
    animation = borderangle, 1, 35, borderSpin, loop
    animation = fade, 1, 3, deepDecel
    animation = workspaces, 1, 4.5, deepDecel, slidefade 20%
}

layerrule = blur, waybar
layerrule = ignorezero, waybar
layerrule = ignorealpha 0.25, waybar

layerrule = blur, rofi
layerrule = ignorezero, rofi
layerrule = ignorealpha 0.25, rofi

layerrule = blur, notifications
layerrule = ignorezero, notifications
layerrule = ignorealpha 0.25, notifications

layerrule = blur, logout_dialog
layerrule = ignorezero, logout_dialog
layerrule = blur, wlogout
layerrule = ignorezero, wlogout

windowrulev2 = opacity 0.82 0.75, class:^(kitty)$
windowrulev2 = blur, class:^(kitty)$
windowrulev2 = opacity 0.90 0.82, class:^(org.kde.dolphin|org.gnome.Nautilus|thunar)$
windowrulev2 = opacity 0.92 0.85, class:^(code-oss|Code|VSCodium|codium)$
windowrulev2 = opacity 0.88 0.80, class:^(Spotify|spotify|org.pulseaudio.pavucontrol|blueman-manager|nm-applet|nm-connection-editor)$
windowrulev2 = float, class:^(org.pulseaudio.pavucontrol|blueman-manager|nm-connection-editor|org.kde.polkit-kde-authentication-agent-1)$
windowrulev2 = size 850 550, class:^(org.pulseaudio.pavucontrol|blueman-manager)$
windowrulev2 = center, class:^(org.pulseaudio.pavucontrol|blueman-manager|nm-connection-editor)$
