* {
    bg-void: rgba(10, 8, 22, 0.72);
    bg-card: rgba(22, 18, 44, 0.65);
    border-rim: rgba(189, 147, 249, 0.35);

    fg-main: #f8f8f2ff;
    fg-dim: #6272a4ff;

    accent-pink: #ff79c6ff;
    accent-cyan: #8be9fdff;
    accent-amber: #ffb86cff;
    accent-violet: #bd93f9ff;

    background-color: transparent;
    text-color: @fg-main;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg-void;
    border: 1px solid;
    border-color: @border-rim;
    border-radius: 20px;
    padding: 24px;
    width: 680px;
    location: center;
    anchor: center;
    x-offset: 0px;
    y-offset: 0px;
}

mainbox {
    spacing: 18px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @bg-card;
    border: 1px solid;
    border-color: rgba(139, 233, 253, 0.4);
    border-radius: 14px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @accent-cyan;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Explorar el cosmos...";
    placeholder-color: @fg-dim;
    text-color: @fg-main;
    cursor: pointer;
}

listview {
    lines: 7;
    columns: 1;
    cycle: true;
    scrollbar: false;
    spacing: 6px;
}

element {
    padding: 10px 14px;
    border-radius: 12px;
    spacing: 12px;
    transition: all 0.2s ease;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-main;
}

element selected.normal {
    background-color: rgba(255, 121, 198, 0.22);
    border: 1px solid;
    border-color: @accent-pink;
    text-color: @accent-cyan;
}

element selected.urgent {
    background-color: rgba(255, 85, 85, 0.3);
    border-color: #ff5555;
    text-color: #ffffff;
}

element-text selected {
    font: "JetBrainsMono Nerd Font Bold 11";
}
