{
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 0,

  "modules-left": [
    "custom/os_icon",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock",
    "custom/weather"
  ],

  "modules-right": [
    "mpris",
    "cpu",
    "memory",
    "wireplumber",
    "network",
    "battery",
    "custom/power"
  ],

  "custom/os_icon": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "format": "{icon}",
    "format-icons": {
      "1": "󰊠",
      "2": "󰊠",
      "3": "󰊠",
      "4": "󰊠",
      "5": "󰊠",
      "urgent": "󰀨",
      "focused": "󰮯",
      "default": "󰊠"
    },
    "persistent-workspaces": {
      "*": 5
    }
  },

  "hyprland/window": {
    "format": "✧ {title}",
    "max-length": 32,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "Firefox",
      "(.*) - Visual Studio Code": "Code",
      "(.*) - Neovim": "Neovim",
      "^$": "Astral Void"
    }
  },

  "clock": {
    "format": "󱑂 {:%H:%M}",
    "format-alt": "󰃭 {:%A, %d %B %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ff79c6'><b>{}</b></span>",
        "days": "<span color='#f8f8f2'><b>{}</b></span>",
        "weeks": "<span color='#8be9fd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffb86c'><b>{}</b></span>",
        "today": "<span color='#bd93f9'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/weather": {
    "format": "{}",
    "interval": 1800,
    "exec": "curl -s 'https://wttr.in/?format=1' || echo '󰖐 Cosmos'",
    "tooltip": false
  },

  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "player-icons": {
      "default": "󰎆",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "max-length": 20
  },

  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage}%",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "interval": 3,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "Usado: {used:0.1f}GiB / {total:0.1f}GiB"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
