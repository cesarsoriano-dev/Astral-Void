{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 38,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,

    "modules-left": ["custom/arch", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "memory", "cpu", "network", "custom/power"],

    "custom/arch": {
        "format": " 󰣇 ",
        "tooltip": true,
        "tooltip-format": "Astral Void Menu",
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "󰄯",
            "2": "󰄯",
            "3": "󰄯",
            "4": "󰄯",
            "5": "󰄯",
            "active": "󰮯",
            "default": "󰄯"
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "separate-outputs": true
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %d de %B de %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "mode"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol || kitty -e pulsemixer",
        "on-click-right": "pamixer -t"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "RAM: {percentage}%\nSwap: {swapUsed:0.1f}G",
        "on-click": "kitty -e btop"
    },

    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "on-click": "kitty -e btop"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format": "IP: {ipaddr}\nVelocidad: {bandwidthDownBits}",
        "on-click": "kitty -e nmtui"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Apagar / Reiniciar",
        "on-click": "wlogout || hyprctl dispatch exit"
    }
}
