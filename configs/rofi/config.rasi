configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "󰣇 Apps";
    display-run:                " Run";
    display-filebrowser:        " Files";
    display-window:             " Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "JetBrainsMono Nerd Font 11";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

* {
    bg-abyss:                   #0a0816c7;
    bg-capsule:                 #120e26a6;
    bg-selected:                #bd93f9;
    bg-urgent:                  #ff5555;
    fg-starlight:               #f8f8f2;
    fg-abyss:                   #0a0816;
    fg-muted:                   #6272a4;
    accent-violet:              #bd93f9;
    accent-cyan:                #8be9fd;
    accent-magenta:             #ff79c6;
    border-titanium:            #bd93f947;

    background-color:           transparent;
    text-color:                 @fg-starlight;
    margin:                     0px;
    padding:                    0px;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      640px;
    border:                     2px solid;
    border-color:               @border-titanium;
    border-radius:              18px;
    background-color:           @bg-abyss;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    14px;
    padding:                    22px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    10px 18px;
    border:                     1px solid;
    border-color:               @border-titanium;
    border-radius:              9999px;
    background-color:           @bg-capsule;
    text-color:                 @fg-starlight;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @accent-magenta;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @fg-starlight;
    cursor:                     text;
    placeholder:                "Buscar en el vacío estelar...";
    placeholder-color:          @fg-muted;
}

listview {
    enabled:                    true;
    columns:                    2;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    8px;
    background-color:           transparent;
    text-color:                 @fg-starlight;
}

element {
    enabled:                    true;
    spacing:                    12px;
    padding:                    10px 14px;
    border-radius:              12px;
    background-color:           transparent;
    text-color:                 @fg-starlight;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg-starlight;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg-starlight;
}

element selected.normal {
    background-color:           @bg-selected;
    text-color:                 @fg-abyss;
    border:                     1px solid;
    border-color:               @accent-cyan;
}

element selected.urgent {
    background-color:           @bg-urgent;
    text-color:                 @fg-abyss;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  bold;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

mode-switcher {
    enabled:                    true;
    spacing:                    10px;
    background-color:           transparent;
    text-color:                 @fg-starlight;
}

button {
    padding:                    8px 14px;
    border:                     1px solid;
    border-color:               @border-titanium;
    border-radius:              9999px;
    background-color:           @bg-capsule;
    text-color:                 @fg-muted;
    cursor:                     pointer;
}

button selected {
    background-color:           @accent-cyan;
    text-color:                 @fg-abyss;
    border-color:               @accent-violet;
}

error-message {
    padding:                    16px;
    border:                     1px solid;
    border-color:               @bg-urgent;
    border-radius:              12px;
    background-color:           @bg-abyss;
    text-color:                 @fg-starlight;
}

textbox {
    background-color:           transparent;
    text-color:                 @fg-starlight;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}
