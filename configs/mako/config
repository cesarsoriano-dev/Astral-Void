# ==============================================================================
#  ASTRAL VOID - Kitty Terminal Configuration
# ==============================================================================

# --- Fuente ---
font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        10.5

# --- Transparencia Planetaria y Desenfoque ---
background_opacity         0.72
dynamic_background_opacity yes
background_blur            20
window_padding_width       14
confirm_os_window_close    0

# --- Paleta Espacio Profundo (Astral Void) ---
foreground              #f8f8f2
background              #0a0816
selection_foreground    #0a0816
selection_background    #bd93f9

# Color del cursor
cursor                  #8be9fd
cursor_text_color       #0a0816

# Bordes de ventana en Kitty
active_border_color     #bd93f9
inactive_border_color   #1e1a38

# --- Colores ANSI Cósmicos ---
# Negro (Espacio Profundo)
color0 #141126
color8 #44475a

