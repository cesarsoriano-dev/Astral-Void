font_family                 JetBrainsMono Nerd Font
bold_font                   auto
italic_font                 auto
bold_italic_font            auto
font_size                   11.5
disable_ligatures           never

cursor                      #8be9fd
cursor_text_color           #0a0816
cursor_shape                beam
cursor_beam_thickness       1.8
cursor_blink_interval       0.5
cursor_stop_blinking_after  15.0

scrollback_lines            10000
wheel_scroll_multiplier     5.0
touch_scroll_multiplier     1.0

url_color                   #8be9fd
url_style                   curly
open_url_with               default
detect_urls                 yes

copy_on_select              yes
strip_trailing_spaces       smart

repaint_delay               8
input_delay                 2
sync_to_monitor             yes
enable_audio_bell           no
visual_bell_duration        0.0

remember_window_size        no
window_padding_width        12 14
placement_strategy          center
hide_window_decorations     yes
confirm_os_window_close     0

tab_bar_edge                bottom
tab_bar_style               powerline
tab_powerline_style         slanted
tab_title_template          " {index}: {title} "

active_tab_foreground       #0a0816
active_tab_background       #bd93f9
active_tab_font_style       bold
inactive_tab_foreground     #f8f8f2
inactive_tab_background     #120e26
inactive_tab_font_style     normal
tab_bar_background          #0a0816

background_opacity          0.75
dynamic_background_opacity  yes

foreground                  #f8f8f2
background                  #0a0816
selection_foreground        #0a0816
selection_background        #bd93f9

active_border_color         #bd93f9
inactive_border_color       #1a1434
bell_border_color           #ffb86c

color0                      #120e26
color8                      #4d4277

color1                      #ff5555
color9                      #ff6e6e

color2                      #50fa7b
color10                     #69ff94

color3                      #ffb86c
color11                     #ffffa5

color4                      #bd93f9
color12                     #d6acff

color5                      #ff79c6
color13                     #ff92df

color6                      #8be9fd
color14                     #a4ffff

color7                      #f8f8f2
color15                     #ffffff

map ctrl+shift+equal        change_font_size all +1.0
map ctrl+shift+minus        change_font_size all -1.0
map ctrl+shift+backspace    change_font_size all 0
map ctrl+shift+c            copy_to_clipboard
map ctrl+shift+v            paste_from_clipboard
map ctrl+shift+t            new_tab_with_cwd
map ctrl+shift+enter        new_window_with_cwd
